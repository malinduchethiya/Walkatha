{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walkatha",
  "main": "public/_worker.js",
  "compatibility_date": "2025-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
